FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KMP_DUPLICATE_LIB_OK=TRUE \
    DEBIAN_FRONTEND=noninteractive \
    RUNPOD_SOURCE=/workspace/input/sample.mp4 \
    FACE_MODE=recognition \
    TRACKER_BACKEND=bytetrack \
    MODEL_PATH=yolov8n.pt \
    PORT=8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    build-essential \
    git \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir \
    torch==2.2.2+cu121 \
    torchvision==0.17.2+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir onnxruntime-gpu==1.17.3

COPY requirements-deployment.txt ./
RUN grep -viE "^torch([=<>! ].*)?$|^torchvision([=<>! ].*)?$|^onnxruntime([=<>! ].*)?$" \
    requirements-deployment.txt > requirements-runpod-filtered.txt \
    && pip install --no-cache-dir -r requirements-runpod-filtered.txt

COPY . .
RUN sed -i 's/\r$//' scripts/runpod_start.sh \
    && chmod +x scripts/runpod_start.sh

EXPOSE 8000

CMD ["bash", "scripts/runpod_start.sh"]
