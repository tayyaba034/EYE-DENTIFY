# Ignore all root content by default, then explicitly allow selected module folders
/*
!/.gitignore
!/alert_decision_module/
!/clothing_feature_extraction_module/
!/explainability_module/
!/facial_recognition_module/
!/height_estimation_module/
!/multi_attribute_fusion_module/
!/multi_object_tracking_module/
!/output_delivery_module/
!/person_detection_module/

# Keep the gitignore file itself tracked
!.gitignore

# Ignore caches, temp files, and build artifacts globally
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/pytest-cache-files*/
**/.cache/
**/runs/
**/runtime/
**/.env
**/venv*/
**/env*/
**/node_modules/
**/.npm-cache/
**/dist/
**/build/

# Ignore model weights and large binary artifacts
**/*.pt
**/*.pth
**/*.onnx
**/*.h5
**/*.weights
**/*.tflite
**/*.task
**/*.zip
**/*.npz
**/*.jpg
**/*.jpeg
**/*.png
**/.insightface_models/
facial_recognition_module/data/01-raw/
facial_recognition_module/data/03-features/

# Ignore editor and OS files
*.swp
*.swo
*.tmp
*.log
*.bak
.DS_Store
Thumbs.db
